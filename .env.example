# Скопируйте этот файл в .env и заполните значения.
# На Beget эти же переменные можно задать в поле "Переменные окружения"
# в настройках Python-приложения (тогда .env не нужен).

# Секретный путь админки (без слэшей). Обычный /admin отдаёт 404.
# Придумайте свою комбинацию, например: admin-kabinet7
ATELLE_ADMIN_PATH=admin-kabinet7

# Логин и пароль администратора (применяются при ПЕРВОМ создании базы).
# Если не заданы: логин admin, пароль генерируется случайно и печатается в логе.
ATELLE_ADMIN_LOGIN=admin
ATELLE_ADMIN_PASSWORD=ПридумайтеДлинныйПароль
